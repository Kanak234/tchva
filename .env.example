# =============================================================================
# Fasal Kavach — environment template
#
# Copy to .env (backend) and web/.env.local (frontend). NEVER commit either.
# .gitignore already excludes them; check with `git status` before pushing.
# =============================================================================

# === Backend (api/) ==========================================================

# --- Storage -----------------------------------------------------------------
# Path to the service-account JSON downloaded from:
#   Firebase console -> Project settings -> Service accounts
#   -> Generate new private key
# On Cloud Run, LEAVE THIS BLANK. The runtime service account is picked up
# automatically and shipping a key file to production is a needless risk.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_CLOUD_PROJECT=fasal-kavach
FIRESTORE_DATABASE=(default)

# Set to "false" to force the in-memory backend. Used by CI and by anyone
# who wants to run the rules engine without a Firebase project.
# Anything else (or unset) means: use Firestore if credentials resolve.
USE_FIRESTORE=true

# --- AI ----------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# --- Data --------------------------------------------------------------------
OPEN_METEO_BASE=https://api.open-meteo.com/v1

# --- Access ------------------------------------------------------------------
# Guards POST /internal/ingest and /internal/seed. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_TOKEN=your-internal-token-here

# DEMO_MODE=true accepts unauthenticated API calls as the fixed uid
# "demo_user", and relaxes the internal-token check.
#
# Convenient for a live pitch. NOT safe for anything with real farmers in
# it. Set to false before the deployment you would hand to a district
# officer, and say out loud on stage that this flag exists.
DEMO_MODE=true

# CORS origin for the deployed frontend.
FRONTEND_ORIGIN=http://localhost:3000


# === Frontend (web/.env.local) ===============================================
NEXT_PUBLIC_API_BASE=http://localhost:8080

# From: Firebase console -> Project settings -> General
#       -> Your apps -> Web app -> SDK setup and configuration
# These are public by design. They identify the project; they authorise
# nothing. What protects data is firestore.rules plus the token check in
# api/auth.py.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=fasal-kavach.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fasal-kavach
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=fasal-kavach.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:000000000000

# Shows the "Try the demo farm" button and allows unauthenticated use.
# Must match DEMO_MODE on the backend, or the button appears and then 401s.
NEXT_PUBLIC_DEMO_MODE=true
